PROJECT_NAME="VITALIS Healthcare Coordination Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment & Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for prototype, or PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/vitalis_db"
DATABASE_URL="sqlite:///./vitalis.db"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
